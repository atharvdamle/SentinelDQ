# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# PostgreSQL
# POSTGRES_HOST is "localhost" so host-run processes (run_pipeline.py,
# test_e2e.py, pytest) work. docker-compose overrides it to "postgres" for the
# containers, so both paths work from the same file.
POSTGRES_HOST=localhost
# In-network clients always reach Postgres on 5432. Set POSTGRES_PORT_HOST
# instead if 5432 is taken on your machine.
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432
POSTGRES_DB=sentineldq
POSTGRES_USER=sentineldq
POSTGRES_PASSWORD=change_me

# MinIO
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=False
MINIO_BUCKET=github-events-raw
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=github_events

# GitHub
GITHUB_EVENTS_URL=https://api.github.com/events
GITHUB_POLL_INTERVAL_SECONDS=60
